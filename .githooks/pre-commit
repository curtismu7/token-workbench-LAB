#!/bin/sh
# Refuse a commit that stages a secret. Installed by `npm install` (core.hooksPath).
if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks protect --staged --redact
fi
echo "pre-commit: gitleaks not installed (brew install gitleaks); there is no CI scan yet (planned for step 3), so nothing else will catch a secret; install gitleaks." >&2
