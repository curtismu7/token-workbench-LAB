    {
      "name": "Mint and decode",
      "description": "Mint the client_credentials sample from the configured real issuer, then decode and introspect it.",
      "item": [
        {
          "name": "Mint client_credentials sample",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mint client_credentials sample\", function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 403, 409, 502]);",
                  "  const b = pm.response.json();",
                  "  if (pm.response.code === 200) { pm.expect(b.token).to.be.a('string').and.not.eql(''); pm.collectionVariables.set('MINTED_TOKEN', b.token); }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5910"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sample\": \"client_credentials\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/mint",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "mint"
              ]
            },
            "description": ""
          },
          "response": []
        },
