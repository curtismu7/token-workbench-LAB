# Copy to .env (git-ignored, never commit it) beside docker-compose.yml. Mock needs no .env at all.
# Real mode is owner-run: it calls the issuer below and nothing else. Hosts here are placeholders (.example).
#
# Opt in (exactly 1). Without it Real stays off, whatever else is set.
TW_REAL=1
# The issuer, https with a host name. PingOne: https://auth.pingone.<region>/<environment id>/as
# PingFederate: its base URL (the issuer in /.well-known/openid-configuration).
TW_REAL_ISSUER=https://idp.example/as
# A client allowed to use the client_credentials grant (and to introspect tokens).
TW_REAL_CLIENT_ID=
# Its secret. Write-only: the lab never shows, returns or logs it.
TW_REAL_CLIENT_SECRET=
# Optional: scopes for the client_credentials request, space separated.
TW_REAL_SCOPE=
# Optional: client_secret_basic (default) or client_secret_post.
TW_REAL_TOKEN_AUTH=
